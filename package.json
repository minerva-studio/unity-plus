{
  "name": "unity-plus",
  "displayName": "Unity Plus",
  "description": "A Unity workflow repair kit for VS Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "minerva-game-studio",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "ms-dotnettools.csdevkit",
    "ms-dotnettools.csharp"
  ],
  "activationEvents": [
    "onLanguage:csharp",
    "workspaceContains:**/ProjectSettings/ProjectVersion.txt",
    "onCommand:unityPlus.refreshProjectFiles",
    "onCommand:unityPlus.createCSharpScript",
    "onCommand:unityPlus.createScriptableObject",
    "onCommand:unityPlus.syncScriptFilename",
    "onCommand:unityPlus.syncClassName",
    "onCommand:unityPlus.showUnityEventReferences",
    "onCommand:unityPlus.openMetaFile",
    "onCommand:unityPlus.openInUnity",
    "onCommand:unityPlus.rescanUnityProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "unityPlus.refreshProjectFiles",
        "title": "Unity Plus: Refresh Project Files"
      },
      {
        "command": "unityPlus.createCSharpScript",
        "title": "Unity Plus: Create C# Script"
      },
      {
        "command": "unityPlus.createScriptableObject",
        "title": "Unity Plus: Create ScriptableObject"
      },
      {
        "command": "unityPlus.syncScriptFilename",
        "title": "Unity Plus: Sync Script Filename"
      },
      {
        "command": "unityPlus.syncClassName",
        "title": "Unity Plus: Rename Type and Script File"
      },
      {
        "command": "unityPlus.showUnityEventReferences",
        "title": "Unity Plus: Show Unity Event References"
      },
      {
        "command": "unityPlus.openMetaFile",
        "title": "Unity Plus: Open Meta File"
      },
      {
        "command": "unityPlus.openInUnity",
        "title": "Unity Plus: Open In Unity"
      },
      {
        "command": "unityPlus.rescanUnityProject",
        "title": "Unity Plus: Rescan Unity Project"
      }
    ],
    "keybindings": [
      {
        "command": "unityPlus.syncClassName",
        "key": "f2",
        "when": "editorTextFocus && editorLangId == csharp && config.unityPlus.rename.overrideF2"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "unityPlus.createCSharpScript",
          "when": "resourceScheme == file",
          "group": "unityPlus"
        },
        {
          "command": "unityPlus.createScriptableObject",
          "when": "resourceScheme == file",
          "group": "unityPlus"
        },
        {
          "command": "unityPlus.openMetaFile",
          "when": "resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "unityPlus.openInUnity",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "unityPlus.openMetaFile",
          "when": "resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "unityPlus.openInUnity",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Unity Plus",
      "properties": {
        "unityPlus.rename.overrideF2": {
          "type": "boolean",
          "default": true,
          "description": "Controls whether F2 in C# files uses Unity Plus class/script rename before falling back to VS Code Rename Symbol."
        },
        "unityPlus.rename.classFileSyncMode": {
          "type": "string",
          "default": "on",
          "enum": [
            "on",
            "off"
          ],
          "description": "Controls automatic C# top-level type/file name synchronization. Use on for safe single-type C# files or off to disable sync."
        },
        "unityPlus.projectFiles.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh Unity project files when C# files are created, moved, or deleted."
        },
        "unityPlus.templates.csharpScriptFile": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative or absolute template file path for Unity Plus C# script creation. Takes priority over unityPlus.templates.csharpScript."
        },
        "unityPlus.templates.scriptableObjectFile": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative or absolute template file path for Unity Plus ScriptableObject creation. Takes priority over unityPlus.templates.scriptableObject."
        },
        "unityPlus.templates.csharpScript": {
          "type": "string",
          "default": "",
          "description": "Template text for Unity Plus C# script creation. Supports ${className} and ${namespaceBlock}."
        },
        "unityPlus.templates.scriptableObject": {
          "type": "string",
          "default": "",
          "description": "Template text for Unity Plus ScriptableObject creation. Supports ${className} and ${namespaceBlock}."
        },
        "unityPlus.eventReferences.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Unity serialized event references in C# files."
        },
        "unityPlus.metaFiles.hideInExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Hide Unity .meta files in the VS Code Explorer while keeping Unity Plus meta file actions available."
        },
        "unityPlus.scan.includeScenesOutsideBuildSettings": {
          "type": "boolean",
          "default": true,
          "description": "Scan scenes outside Unity Build Settings when looking for event references."
        },
        "unityPlus.logging.level": {
          "type": "string",
          "default": "info",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "Controls the verbosity of the Unity Plus output channel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run compile && mocha \"out/test/**/*.test.js\"",
    "package:vsix": "node scripts/package-extension.mjs",
    "package:install": "node scripts/package-extension.mjs --install"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.9",
    "@types/vscode": "^1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.57.0",
    "mocha": "^10.7.0",
    "typescript": "^5.5.3"
  }
}
